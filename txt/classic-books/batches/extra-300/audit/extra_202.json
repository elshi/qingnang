        "text": "〔穤同糯〕"
      },
      {
        "ordinal": 824,
        "kind": "校",
        "text": "〔《說文》蘖，伐木餘也〕"
      },
      {
        "ordinal": 827,
        "kind": "訂",
        "text": "本經續疏"
      },
      {
        "ordinal": 885,
        "kind": "校",
        "text": "〔《玉篇》「顦顇，憂貌」〕"
      },
      {
        "ordinal": 902,
        "kind": "校",
        "text": "〔《六書故》「挼，按揉也」〕"
      },
      {
        "ordinal": 902,
        "kind": "校",
        "text": "〔殷，赤黑色〕"
      },
      {
        "ordinal": 916,
        "kind": "校",
        "text": "〔《唐韻》「蕻，草菜心長也」〕"
      },
      {
        "ordinal": 958,
        "kind": "校",
        "text": "〔疕，頭瘍，又謂禿也〕"
      },
      {
        "ordinal": 958,
        "kind": "校",
        "text": "〔毓，同育〕"
      },
      {
        "ordinal": 958,
        "kind": "校",
        "text": "〔鬯，同暢〕"
      },
      {
        "ordinal": 970,
        "kind": "校",
        "text": "〔杪，小也，木細枝〕"
      },
      {
        "ordinal": 975,
        "kind": "校",
        "text": "〔豭，牡豬〕"
      },
      {
        "ordinal": 981,
        "kind": "校",
        "text": "〔爇，同焫，燒也〕"
      },
      {
        "ordinal": 987,
        "kind": "校",
        "text": "〔熯，乾貌《說文》，火盛貌《玉篇》〕"
      },
      {
        "ordinal": 988,
        "kind": "校",
        "text": "〔䵴，面黑《玉篇》〕"
      },
      {
        "ordinal": 989,
        "kind": "校",
        "text": "〔劚同斸，斫也《說文》〕"
      },
      {
        "ordinal": 990,
        "kind": "校",
        "text": "〔䣛，膝本字〕"
      },
      {
        "ordinal": 994,
        "kind": "校",
        "text": "〔蹐，小步也《說文》。駁，龐雜也〕"
      },
      {
        "ordinal": 1004,
        "kind": "校",
        "text": "〔鮏，魚臭也《說文》〕"
      },
      {
        "ordinal": 1007,
        "kind": "校",
        "text": "〔以鹽米釀之使如葅熟而食之也《釋名》〕"
      },
      {
        "ordinal": 1008,
        "kind": "校",
        "text": "〔骽，與腿同《廣韻》。股也《玉篇》〕"
      },
      {
        "ordinal": 1010,
        "kind": "校",
        "text": "〔懽，與歡同，喜也《廣韻》〕"
      },
      {
        "ordinal": 1011,
        "kind": "校",
        "text": "〔蒻，土下白莖也〕"
      },
      {
        "ordinal": 1011,
        "kind": "校",
        "text": "〔菂，蓮實〕"
      },
      {
        "ordinal": 1011,
        "kind": "校",
        "text": "〔薏，蓮心〕"
      },
      {
        "ordinal": 1012,
        "kind": "校",
        "text": "〔蒔，更種也〕"
      },
      {
        "ordinal": 1015,
        "kind": "校",
        "text": "〔縠，縐紗〕"
      },
      {
        "ordinal": 1022,
        "kind": "校",
        "text": "〔藂，叢也〕"
      },
      {
        "ordinal": 1036,
        "kind": "校",
        "text": "〔眹，目精也〕"
      },
      {
        "ordinal": 1049,
        "kind": "校",
        "text": "〔茝，音芷，香草《玉篇》。虈也，齊謂之茝，楚謂之離《說文》〕"
      },
      {
        "ordinal": 1063,
        "kind": "校",
        "text": "〔黲，音慘，淺青黑也《說文》，暗《廣韻》〕"
      },
      {
        "ordinal": 1082,
        "kind": "校",
        "text": "〔桮，俗作盃，通作杯《說文》〕"
      },
      {
        "ordinal": 1087,
        "kind": "校",
        "text": "〔籜，竹皮也《類篇》〕"
      },
      {
        "ordinal": 1148,
        "kind": "校",
        "text": "〔㒩，作倮，謂蠶也〕"
      },
      {
        "ordinal": 1148,
        "kind": "校",
        "text": "〔巵，酒器《玉篇》〕"
      },
      {
        "ordinal": 1155,
        "kind": "校",
        "text": "〔啘，乾嘔，呃逆〕"
      },
      {
        "ordinal": 1180,
        "kind": "校",
        "text": "〔蒔，移植，栽種〕"
      },
      {
        "ordinal": 1194,
        "kind": "校",
        "text": "〔觜，通嘴〕"
      },
      {
        "ordinal": 1195,
        "kind": "校",
        "text": "〔隻，獨也〕"
      },
      {
        "ordinal": 1212,
        "kind": "校",
        "text": "〔帀，環繞〕"
      },
      {
        "ordinal": 1238,
        "kind": "校",
        "text": "〔駮，混雜〕"
      },
      {
        "ordinal": 1241,
        "kind": "訂",
        "text": "本經序疏要"
      },
      {
        "ordinal": 1288,
        "kind": "校",
        "text": "〔癔，心意病也《集韻》〕"
      },
      {
        "ordinal": 1399,
        "kind": "校",
        "text": "〔洊，同瀳，水至也《說文》〕"
      },
      {
        "ordinal": 1634,
        "kind": "校",
        "text": "〔骩骳，屈曲也〕"
      },
      {
        "ordinal": 1737,
        "kind": "校",
        "text": "〔浸，澤之總名〕"
      },
      {
        "ordinal": 1737,
        "kind": "校",
        "text": "〔淀，淺水也《玉篇》〕"
      },
      {
        "ordinal": 1737,
        "kind": "校",
        "text": "〔漶漫，不分別貌〕"
      },
      {
        "ordinal": 1796,
        "kind": "校",
        "text": "〔䐭，赤白痢也《玉篇》〕"
      },
      {
        "ordinal": 1796,
        "kind": "校",
        "text": "〔綰，貫也，繫也〕"
      },
      {
        "ordinal": 2503,
        "kind": "校",
        "text": "〔侈，微張貌〕"
      },
      {
        "ordinal": 2503,
        "kind": "校",
        "text": "〔除草曰芟，除木曰柞〕"
      },
      {
        "ordinal": 2539,
        "kind": "校",
        "text": "〔在頤曰鬚，在頰曰髯〕"
      },
      {
        "ordinal": 2539,
        "kind": "校",
        "text": "〔髭，口上鬚也《說文》〕"
      },
      {
        "ordinal": 2671,
        "kind": "校",
        "text": "〔㿅同癬〕"
      },
      {
        "ordinal": 2743,
        "kind": "校",
        "text": "〔聚沙曰塸〕"
      },
      {
        "ordinal": 2744,
        "kind": "校",
        "text": "〔攖，拈也，亂也〕"
      },
      {
        "ordinal": 2844,
        "kind": "校",
        "text": "〔朻，木下曲《說文》〕"
      },
      {
        "ordinal": 3021,
        "kind": "校",
        "text": "〔䐴，腰忽痛也《玉篇》〕"
      }
