.catalog-page {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background-color: #f8f3ea;
  background-image: url("/assets/common/paper-bg.png");
  background-position: top center;
  background-repeat: repeat-y;
  background-size: 750rpx auto;
}

.catalog-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.catalog-search {
  display: flex;
  align-items: center;
  flex: 0 0 68rpx;
  height: 68rpx;
  margin: 13rpx 28rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(225, 214, 198, 0.85);
  border-radius: 34rpx;
  color: #a0968b;
  background: rgba(255, 253, 248, 0.82);
  font-size: 25rpx;
}

.catalog-search image {
  width: 29rpx;
  height: 29rpx;
  margin-right: 16rpx;
  opacity: 0.62;
}

.catalog-search__input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: #40372d;
  font-size: 25rpx;
}

.catalog-search__placeholder {
  color: #a0968b;
}

.catalog-search__clear {
  color: #aa762f;
  font-size: 21rpx;
}

.catalog-list {
  padding: 0 24rpx 32rpx;
}

.tabbar-spacer {
  height: calc(125rpx + env(safe-area-inset-bottom));
}

.catalog-card {
  margin-bottom: 15rpx;
  padding: 22rpx 23rpx 18rpx;
  border: 1rpx solid rgba(225, 214, 198, 0.85);
  border-radius: 7rpx;
  background: rgba(255, 253, 248, 0.78);
  box-shadow: 0 3rpx 10rpx rgba(78, 59, 35, 0.035);
}

.catalog-card__title {
  color: #31291f;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.catalog-card__meta {
  margin-top: 8rpx;
  color: #a27942;
  font-size: 21rpx;
}

.catalog-card__content {
  margin-top: 12rpx;
  color: #675e53;
  font-size: 29rpx;
  line-height: 1.65;
}

.result-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #594b3b;
  font-size: 21rpx;
}

.result-count {
  color: #9b9084;
}

.state-block {
  padding: 46rpx 20rpx;
  color: #81776b;
  font-size: 24rpx;
  text-align: center;
}

.catalog-list .state-block {
  font-size: 29rpx;
}

.state-block--muted {
  color: #aaa095;
}

.state-action {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid #c99b56;
  border-radius: 30rpx;
  color: #a8752c;
  font-size: 21rpx;
}
