.category-tabs {
  display: flex;
  flex: 0 0 82rpx;
  height: 82rpx;
  padding: 0 70rpx;
  border-bottom: 1rpx solid rgba(214, 202, 185, 0.7);
}

.category-tab {
  position: relative;
  flex: 1;
  height: 82rpx;
  color: #746b60;
  font-size: 27rpx;
  line-height: 82rpx;
}

.category-tab--active {
  color: #a87025;
}

.category-tab--active::after {
  position: absolute;
  right: 50%;
  bottom: -1rpx;
  width: 52rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #bd883c;
  transform: translateX(50%);
  content: "";
}
