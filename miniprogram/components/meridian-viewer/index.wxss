:host{display:block;height:100%}.map{position:relative;height:100%;overflow:hidden;background:#f8f3ea}.body{position:absolute;top:0;left:6%;width:88%;height:93%;mix-blend-mode:multiply}.caption,.hint{position:absolute;color:#756959;font-size:21rpx}.caption{left:15rpx;top:14rpx}.hint{bottom:12rpx;width:100%;text-align:center}.map button.label{position:absolute;display:flex;flex-direction:column;justify-content:center;width:27%;min-height:78rpx;margin:0;padding:5rpx 7rpx;border:0;border-top:1rpx solid #d4c5af;border-radius:0;background:rgba(248,243,234,.94);color:#31291f}.label.left{left:0}.label.right{right:0}.label-row{width:100%;display:flex;align-items:center;justify-content:space-between;white-space:nowrap;font-size:25rpx;font-weight:600}.arrow{color:#98784e}.code{display:flex;align-items:center;gap:8rpx;margin-bottom:4rpx;font-size:18rpx;color:#736453;line-height:1}.code view{width:18rpx;height:3rpx}.retry{position:absolute;left:29%;right:29%;top:47%;text-align:center}.retry button{font-size:24rpx;color:#916626}@media(max-height:620px){.map button.label{min-height:55rpx;padding:0 4rpx}.code{margin-bottom:1rpx}}
