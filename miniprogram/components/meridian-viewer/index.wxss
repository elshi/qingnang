
:host { display:block; }
.chart-panel { padding:0 18rpx 12rpx; background:#f8f3eb; }
.chart-image-wrap { position:relative; height:655rpx; }
.chart-image { display:block; width:100%; height:100%; }
.chart-caption { position:absolute; left:10rpx; top:24rpx; color:#8f806e; font-size:22rpx; }
.chart-annotation { position:absolute; display:flex; align-items:flex-end; width:286rpx; height:58rpx; }
.chart-annotation--left { left:0; }
.chart-annotation--right { right:0; flex-direction:row-reverse; }
.chart-callout { display:flex; align-items:center; width:222rpx; min-width:0; height:58rpx; margin:0; padding:0 12rpx; border-bottom:1rpx solid rgba(120,97,65,.57); border-radius:0; background:transparent; color:#493729; font-family:"KaiTi","STKaiti",serif; font-size:25rpx; font-weight:600; line-height:1; white-space:nowrap; }
.chart-callout--left { justify-content:flex-end; text-align:right; }
.chart-callout--right { justify-content:flex-start; text-align:left; }
.chart-callout.is-current { gap:8rpx; color:#9b631f; background:transparent; }
.selection-icon { display:flex; flex-shrink:0; align-items:center; justify-content:center; width:25rpx; height:25rpx; border:2rpx solid currentColor; border-radius:50%; color:currentColor; font-family:Arial,sans-serif; font-size:17rpx; font-weight:700; line-height:1; }
.chart-callout:active { opacity:.72; }
.chart-callout::after { border:0; }
.chart-image-wrap button.chart-callout { width:222rpx; min-width:0; max-width:222rpx; margin:0; }
.callout-leader { position:relative; width:64rpx; height:1rpx; opacity:.7; pointer-events:none; }
.callout-leader::after { position:absolute; top:-5rpx; width:10rpx; height:10rpx; border:2rpx solid #f8f3eb; border-radius:50%; background:#a77a3e; content:""; }
.chart-annotation--left .callout-leader::after { right:-5rpx; }
.chart-annotation--right .callout-leader::after { left:-5rpx; }
