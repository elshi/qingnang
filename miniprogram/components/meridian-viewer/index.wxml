<view class="map">
  <image wx:if="{{src && !failed}}" class="body" src="{{src}}" data-url="{{src}}" mode="aspectFit" binderror="imageError" aria-label="{{group.label}}体表循行示意"></image>
  <view wx:elif="{{failed}}" class="retry"><button bindtap="retry">重新加载总图</button></view>
  <text class="caption">体表循行示意</text>
  <button wx:for="{{labels}}" wx:key="key" class="label {{item.side}}" style="top:{{item.top}}%" data-id="{{item.id}}" bindtap="selectLabel" aria-label="查看{{item.title}}详情">
    <view class="code"><view style="background:{{item.color}}"></view>{{item.code}}</view>
    <view class="label-row"><text>{{item.title}}</text><text class="arrow">›</text></view>
  </button>
  <text class="hint">轻点经脉名称，查看详情</text>
</view>
