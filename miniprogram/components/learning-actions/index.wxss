.learning-actions { display:flex; align-items:center; justify-content:flex-end; gap:20rpx; flex-wrap:wrap; padding:10rpx 32rpx; background:var(--reader-panel, #faf7f1); border-bottom:1rpx solid var(--reader-border, #e9e1d7); }
.learning-action, .notes-button { display:flex; align-items:center; margin:0; min-height:64rpx; padding:8rpx 0; background:transparent; color:var(--reader-accent, #a77936); font-size:24rpx; }
.learning-action { width:auto !important; min-width:0; font-weight:400 !important; }
.learning-action::after, .notes-button::after { border:0; }
.learning-icon { width:30rpx; height:30rpx; margin-right:8rpx; }

.share-icon { width:30rpx; margin-right:8rpx; font-size:32rpx; line-height:1; text-align:center; }

.related-notes { padding:24rpx 26rpx 48rpx; color:var(--reader-text, #443a2f); }
.notes-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:18rpx; font-size:28rpx; }
.notes-button { width:auto !important; margin:0; padding:12rpx 0; color:var(--reader-accent, #a77936); background:transparent; font-size:25rpx; font-weight:400; line-height:1.6; }
.note-block { margin-bottom:20rpx; padding:24rpx; border:1rpx solid var(--reader-border, #e1d6c6); border-radius:12rpx; background:var(--reader-panel, #fffdf8); }
.note-block:active { opacity:.8; }
.note-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:30rpx; line-height:1.5; font-weight:600; }
.note-content { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:4; max-height:6.6em; margin-top:12rpx; font-size:27rpx; line-height:1.65; white-space:pre-wrap; overflow-wrap:anywhere; }
.note-date { margin-top:16rpx; color:var(--reader-muted, #927f66); font-size:22rpx; }
.notes-empty, .notes-status { padding:35rpx 0; color:var(--reader-muted, #927f66); font-size:25rpx; line-height:1.8; text-align:center; }

.notes-empty .notes-button, .notes-status .notes-button { margin:0 auto; }
