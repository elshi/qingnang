.learning-actions { display:flex; align-items:center; justify-content:flex-end; gap:24rpx; padding:10rpx 32rpx; background:#faf7f1; border-bottom:1rpx solid #e9e1d7; }
button { display:flex; align-items:center; margin:0; min-height:64rpx; padding:8rpx 0; background:transparent; color:#a77936; font-size:24rpx; }
.learning-actions button { width:auto; min-width:0; margin:0; font-weight:400; }
.learning-actions button { width:auto !important; font-weight:400 !important; }
button::after { border:0; }
image { width:30rpx; height:30rpx; margin-right:8rpx; }
