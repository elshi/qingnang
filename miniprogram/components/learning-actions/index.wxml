<view wx:if="{{showNotes}}" class="related-notes" catchtap="noop">
  <view class="notes-heading"><text>关联笔记</text><button class="notes-button" wx:if="{{ref && loggedIn}}" bindtap="note">写笔记</button></view>
  <view wx:if="{{error}}" class="notes-status"><text>{{error}}</text><button class="notes-button" bindtap="reloadNotes">重试</button></view>
  <view wx:if="{{!loggedIn}}" class="notes-empty"><text>登录后查看当前内容的笔记</text><button class="notes-button" bindtap="loginForNotes">微信登录</button></view>
  <block wx:else>
    <view wx:for="{{items}}" wx:key="key" class="note-block" data-key="{{item.key}}" bindtap="editRelatedNote" aria-role="button" aria-label="查看笔记：{{item.title}}">
      <view class="note-title">{{item.title}}</view>
      <view class="note-content">{{item.content}}</view>
      <view class="note-date">{{item.dateLabel}}</view>
    </view>
    <view wx:if="{{loading && !items.length}}" class="notes-empty">正在加载笔记…</view>
    <view wx:elif="{{!items.length && !error}}" class="notes-empty"><text>暂无关联笔记</text><button class="notes-button" wx:if="{{ref}}" bindtap="note">写下你的心得</button></view>
  </block>
</view>
<view wx:elif="{{ref}}" class="learning-actions">
<button class="learning-action" bindtap="favorite" aria-label="{{favorite?'取消收藏':'收藏'}}"><image class="learning-icon" src="{{favorite?'/assets/personal/star-filled.png':'/assets/personal/star.png'}}" /><text>{{favorite?'已收藏':type==='chapter'?'收藏本章':'收藏'}}</text></button>
<button class="learning-action" wx:if="{{type==='chapter'}}" bindtap="favoriteBook"><image class="learning-icon" src="/assets/personal/book.png" /><text>{{bookFavorite?'本书已收藏':'收藏本书'}}</text></button>
<button class="learning-action" bindtap="note"><image class="learning-icon" src="/assets/personal/note.png" /><text>写笔记</text></button>
<button class="learning-action" open-type="share" aria-label="分享当前内容"><text class="share-icon" aria-hidden="true">↗</text><text>分享</text></button>
</view>
