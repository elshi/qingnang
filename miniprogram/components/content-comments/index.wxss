:host { display:block; }
.comments { margin:24rpx 26rpx 40rpx; padding-top:28rpx; border-top:1rpx solid var(--reader-border, #e1d6c6); color:var(--reader-text, #443a2f); font-size:27rpx; line-height:1.65; letter-spacing:0; }
.comments-heading { display:flex; align-items:center; justify-content:space-between; font-size:31rpx; font-weight:600; }
.comments-count, .comments-hint, .comment-date { color:var(--reader-muted, #927f66); font-size:23rpx; font-weight:400; }
.comments-hint { margin:10rpx 0 20rpx; }
.comment-input { display:block; box-sizing:border-box; width:100%; min-height:180rpx; padding:22rpx; border:1rpx solid var(--reader-border, #e1d6c6); border-radius:10rpx; background:var(--reader-panel, #fffdf8); color:var(--reader-text, #443a2f); font-size:27rpx; line-height:1.7; }
.comment-placeholder { color:var(--reader-muted, #927f66); }
.comment-compose-footer { display:flex; align-items:center; justify-content:space-between; margin:16rpx 0 24rpx; }
.comment-compose-footer .comments-hint { margin:0; }
.comments button { width:auto !important; min-width:0; margin:0; padding:12rpx 0; border:0; background:transparent; color:var(--reader-accent, #a77936); font-size:25rpx; font-weight:400; line-height:1.6; }
.comments button::after { border:0; }
.comments .comment-submit { flex:none; margin-left:auto !important; margin-right:0 !important; padding:14rpx 28rpx; border-radius:8rpx; background:var(--reader-accent, #a77936); color:var(--reader-bg, #fffaf2); }
.comments .comment-login { width:100% !important; padding:22rpx; margin:16rpx 0 24rpx; border:1rpx solid var(--reader-border, #e1d6c6); border-radius:10rpx; }
.comments button[disabled] { opacity:.55; }
.comment { padding:24rpx 0; border-top:1rpx solid var(--reader-border, #e1d6c6); }
.comment-meta { display:flex; align-items:center; gap:18rpx; margin-bottom:12rpx; }
.comment-author { font-weight:600; font-size:25rpx; }
.comments .comment-delete { flex:none; margin-left:auto !important; margin-right:0 !important; font-size:23rpx; }
.comment-content { display:block; white-space:pre-wrap; overflow-wrap:anywhere; }
.comments-status { padding:30rpx 0; color:var(--reader-muted, #927f66); font-size:25rpx; text-align:center; }
.comments-error { color:var(--commentary-accent, #a44735); font-size:25rpx; }
.comments .comments-more { margin:12rpx auto; padding:14rpx 24rpx; }
