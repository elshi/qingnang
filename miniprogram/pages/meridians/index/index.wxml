<view class="atlas-home">
  <custom-nav title="经络" showBack="{{true}}"></custom-nav>
  <view wx:if="{{loading || error}}" class="atlas-state">{{error || '正在打开经络图谱…'}}<button wx:if="{{error}}" bindtap="loadAtlas">重新加载</button></view>
  <block wx:elif="{{group}}">
    <view class="atlas-switch">
      <button wx:for="{{groups}}" wx:key="key" class="{{group.key === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectTab" aria-role="tab" aria-selected="{{group.key === item.key}}">{{item.label}}</button>
    </view>
    <meridian-viewer class="atlas-view" group="{{group}}" bindselect="selectMeridian"></meridian-viewer>
  </block>
  <app-tab-bar></app-tab-bar>
</view>
