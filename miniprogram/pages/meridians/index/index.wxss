.meridian-page { display:flex; flex-direction:column; height:100vh; overflow:hidden; background:#f8f3eb; }
.meridian-tabs { flex-shrink:0; display:flex; height:88rpx; padding:0 38rpx; border-bottom:1rpx solid #e4d9c9; }
.meridian-tab { position:relative; flex:1; display:flex; align-items:center; justify-content:center; color:#8c8072; font-size:31rpx; font-weight:600; }
.meridian-tab.is-active { color:#a66e25; }
.meridian-tab.is-active::after { content:""; position:absolute; bottom:0; left:50%; width:116rpx; height:5rpx; transform:translateX(-50%); border-radius:4rpx; background:#ac772f; }
.meridian-scroll { flex:1; min-height:0; height:0; }
.meridian-selection { padding:26rpx 26rpx 18rpx; background:#fcf8f1; }
.color-dot { flex-shrink:0; width:14rpx; height:14rpx; border-radius:50%; }
.selected-info { margin-top:30rpx; padding:24rpx 20rpx 20rpx; border:1rpx solid #dcc6a7; border-radius:14rpx; background:#fffaf2; }
.info-heading { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.selected-title { display:flex; align-items:center; gap:12rpx; color:#3a2a19; font-family:"KaiTi","STKaiti",serif; font-size:31rpx; font-weight:600; }
.selected-title .color-dot { width:18rpx; height:18rpx; }
.detail-link { flex-shrink:0; display:flex; align-items:center; justify-content:flex-end; min-height:64rpx; color:#a36e2a; font-size:24rpx; }
.detail-link image { width:26rpx; height:26rpx; margin-left:3rpx; }
.point-heading { display:flex; justify-content:space-between; margin:14rpx 0 16rpx; color:#88765d; font-size:23rpx; }
.point-table { overflow:hidden; border:1rpx solid #e1d3be; border-radius:8rpx; }
.point-row { display:flex; border-bottom:1rpx solid #e6dbc9; }
.point-row:last-child { border-bottom:0; }
.point-cell { display:flex; flex-direction:column; justify-content:center; align-items:center; width:20%; min-width:0; min-height:88rpx; padding:12rpx 2rpx; border-right:1rpx solid #e6dbc9; background:#fffdf8; }
.point-cell:last-child { border-right:0; }
.point-cell.is-empty { background:#faf6ee; }
.point-cell--button { margin:0; border-radius:0; }
.point-cell--button:active { background:#f4ead9; }
.point-name { color:#51402f; font-size:26rpx; line-height:1.4; white-space:nowrap; }
.point-code { color:#a08d73; font-size:19rpx; line-height:1.4; margin-top:3rpx; }
.point-note,.learning-note { color:#9b8b76; font-size:21rpx; line-height:1.6; }
.point-note { margin-top:16rpx; }
.learning-note { margin-top:22rpx; text-align:center; }
.bottom-spacer { height:calc(134rpx + env(safe-area-inset-bottom)); }
.meridian-page .meridian-tabs button.meridian-tab { width:auto; margin:0; }
.meridian-page .selected-info button.detail-link { width:auto; margin:0; }
.meridian-page .selected-info button.detail-link[disabled] { color:#b8aa98; opacity:.7; }
.inline-state { padding:24rpx 10rpx; color:#91816d; font-size:23rpx; line-height:1.6; text-align:center; }
.inline-state button { display:inline-block; width:auto; margin-left:12rpx; color:#a36e2a; font-size:23rpx; }
.meridian-navigation { position:relative; z-index:3; flex-shrink:0; background:#f8f3eb; }
.meridian-tabs { position:relative; z-index:3; background:#f8f3eb; }
.meridian-scroll { position:relative; overflow:hidden; }
