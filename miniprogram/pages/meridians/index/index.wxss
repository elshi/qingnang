.atlas-home{display:flex;flex-direction:column;height:100vh;box-sizing:border-box;padding-bottom:calc(112rpx + env(safe-area-inset-bottom));background:#f8f3ea;color:#31291f}.atlas-switch{flex:none;display:flex;gap:4rpx;margin:8rpx 28rpx;padding:5rpx;border:1rpx solid #d9c9af;border-radius:10rpx;background:#eee6d8}.atlas-switch button{flex:1;margin:0;width:auto;line-height:66rpx;font-size:28rpx;color:#6e614e;border-radius:6rpx}.atlas-switch .active{color:#fff7e5;background:#203242}.atlas-view{flex:1;min-height:0;margin:5rpx 14rpx}.atlas-state{margin:auto;text-align:center;color:#796b57;font-size:26rpx}.atlas-state button{margin-top:20rpx;color:#976b35}
