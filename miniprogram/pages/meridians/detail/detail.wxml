<view class="detail-page meridian-detail page-fade">
  <custom-nav title="经脉详情" showBack="{{true}}"></custom-nav>
  <learning-actions wx:if="{{item && !loading && !error}}" type="meridian" item="{{item}}" />
  <scroll-view class="detail-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="detail-state">正在加载经络…</view>
    <view wx:elif="{{error}}" class="detail-state"><view>{{error}}</view><button class="detail-retry" bindtap="retry">重新加载</button></view>
    <block wx:elif="{{item}}">
      <view class="detail-hero">
        <view class="detail-title">{{item.title}}</view>
        <view wx:if="{{item.english_name}}" class="detail-meta">{{item.english_name}}</view>
        <view wx:if="{{meta.length}}" class="tag-row"><text wx:for="{{meta}}" wx:key="key" class="case-tag">{{item.value}}</text></view>
      </view>
      <view wx:for="{{sections}}" wx:key="key" wx:for-item="section" class="detail-card">
        <view class="detail-card__title">{{section.title}}</view>
        <text class="detail-content meridian-content" user-select="{{true}}">{{section.content}}</text>
      </view>
      <view class="detail-card point-card">
        <view class="detail-card__title">相关穴位<text wx:if="{{!pointsLoading}}" class="point-count">{{pointTotal}} 穴</text></view>
        <view wx:if="{{pointsLoading}}" class="inline-state">正在加载穴位…</view>
        <view wx:elif="{{pointsError}}" class="inline-state"><text>{{pointsError}}</text><button bindtap="retryPoints">重新加载</button></view>
        <view wx:elif="{{!rows.length}}" class="inline-state">暂无穴位数据</view>
        <view wx:else class="point-table">
          <view wx:for="{{rows}}" wx:key="key" class="point-row">
            <block wx:for="{{item.cells}}" wx:for-item="point" wx:key="key">
              <button wx:if="{{point.clickable}}" class="point-cell point-cell--button" data-id="{{point.id}}" bindtap="openAcupoint"><text class="point-name">{{point.name}}</text><text wx:if="{{point.code}}" class="point-code">{{point.code}}</text></button>
              <view wx:else class="point-cell is-empty"></view>
            </block>
          </view>
        </view>
      </view>
      <view wx:if="{{!sections.length}}" class="detail-card detail-content">暂无详细内容</view>
      <view class="disclaimer">{{disclaimer}}</view>
    </block>
  </scroll-view>
</view>
