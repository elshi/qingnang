@import "../../../styles/catalog-list.wxss";

.book-progress {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx 12rpx;
  margin-top: 10rpx;
}

.book-progress__label {
  padding: 3rpx 11rpx;
  border-radius: 4rpx;
  color: #875b24;
  background: #f2e8d7;
  font-size: 21rpx;
  line-height: 30rpx;
}

.book-progress__label--muted {
  color: #6d6255;
  background: #eee8de;
}

.book-progress__track {
  flex: 1 1 108rpx;
  height: 7rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: rgba(215, 199, 176, 0.68);
}

.book-progress__bar {
  height: 100%;
  border-radius: inherit;
  background: #bd7c25;
}
