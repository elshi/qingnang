@import "../../../styles/personal.wxss";
.history-group { margin-top:26rpx; }
.history-date { padding:10rpx 12rpx; color:#8d7148; background:#f2ebe0; font-size:34rpx; }
.history-item { padding:28rpx 4rpx; border-bottom:1rpx solid #e9e1d7; }
.history-heading { display:flex; justify-content:space-between; align-items:baseline; gap:20rpx; }
.history-time { flex-shrink:0; font-size:31rpx; color:#8d8275; }
.history-item .personal-meta { margin-top:3rpx; line-height:1.55; }
.history-footer { margin:55rpx 0 15rpx; color:#928778; text-align:center; font-size:31rpx; }
