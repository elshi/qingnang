@import "../../../styles/personal.wxss";
@import "../../../styles/personal-catalog.wxss";
.history-group { margin-top:10rpx; }
.history-date { margin:0 0 13rpx; padding:10rpx 13rpx; color:#8d7148; background:#f2ebe0; font-size:23rpx; }
.history-heading { display:flex; justify-content:space-between; align-items:baseline; gap:16rpx; }
.history-heading .personal-title { flex:1; min-width:0; }
.history-time { flex-shrink:0; font-size:21rpx; color:#8d8275; }
.history-item .personal-meta { margin-top:5rpx; line-height:1.5; }
.history-footer { margin:32rpx 0 15rpx; color:#928778; text-align:center; font-size:23rpx; }
