@import "../../../styles/personal.wxss";
.profile-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  color: #31291f;
  background-color: #f8f3ea;
  background-image: url("/assets/common/paper-bg.png");
  background-position: top center;
  background-repeat: repeat-y;
  background-size: 750rpx auto;
}
.profile-content { display:flex; flex:1; flex-direction:column; min-height:0; padding:0 36rpx; }
.profile-intro { text-align:center; padding-top:48rpx; }
.profile-emblem { display:flex; align-items:center; justify-content:center; width:148rpx; height:148rpx; margin:0 auto; border:1rpx solid #c9b69b; border-radius:50%; }
.profile-emblem image { width:82rpx; height:82rpx; }
.profile-description { margin-top:36rpx; color:#857664; font-size:27rpx; line-height:1.5; }
.profile-name { margin-top:20rpx; font-size:29rpx; font-family:"Songti SC","SimSun",serif; }
.profile-name + .profile-description { margin-top:16rpx; }
.profile-intro .personal-primary { margin-top:30rpx; padding:20rpx 24rpx; border-radius:8rpx; font-size:29rpx; letter-spacing:1rpx; }
.profile-intro .personal-sync { margin-top:22rpx; font-size:25rpx; }
.profile-intro .personal-error { font-size:25rpx; }
.profile-menu { margin-top:44rpx; }
.profile-menu-row { display:flex; align-items:center; width:100%; min-height:92rpx; margin:0; border-bottom:1rpx solid #ded0bd; border-radius:0; text-align:left; color:#31291f; font-size:30rpx; }
.profile-page button.profile-menu-row { width:100% !important; }
.menu-icon { width:38rpx; height:38rpx; margin-right:22rpx; }
.menu-chevron { width:20rpx; height:20rpx; margin-left:auto; }
.profile-footer { display:flex; justify-content:center; gap:18rpx; margin-top:auto; padding:20rpx 0 4rpx; }
.privacy-link { padding:14rpx 0; margin:0; font-size:23rpx; color:#857664; }
