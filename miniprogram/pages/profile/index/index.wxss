@import "../../../styles/personal.wxss";
.profile-page { display:flex; flex-direction:column; height:100vh; min-height:1100rpx; padding-bottom:calc(112rpx + env(safe-area-inset-bottom)); }
.profile-content { display:flex; flex:1; flex-direction:column; min-height:0; padding:0 52rpx; }
.profile-intro { text-align:center; padding-top:14rpx; }
.profile-emblem { display:flex; align-items:center; justify-content:center; width:200rpx; height:200rpx; margin:0 auto; border:1rpx solid #bbaa93; border-radius:50%; }
.profile-emblem image { width:112rpx; height:112rpx; }
.profile-description { margin-top:80rpx; color:#83796b; font-size:34rpx; line-height:1.7; }
.profile-name { margin-top:26rpx; font-size:32rpx; font-family:"Songti SC","SimSun",serif; }
.profile-name + .profile-description { margin-top:24rpx; }
.profile-intro .personal-primary { margin-top:40rpx; }
.profile-menu { margin-top:38rpx; }
.profile-menu-row { display:flex; align-items:center; width:100%; min-height:108rpx; margin:0; border-bottom:1rpx solid #e9e1d7; border-radius:0; text-align:left; color:#30281f; font-size:40rpx; }
.profile-page button.profile-menu-row { width:100% !important; }
.menu-icon { width:50rpx; height:50rpx; margin-right:30rpx; }
.menu-chevron { width:26rpx; height:26rpx; margin-left:auto; }
.profile-footer { display:flex; justify-content:center; gap:24rpx; margin-top:auto; padding:26rpx 0 12rpx; }
.privacy-link { padding:16rpx 0; margin:0; font-size:28rpx; color:#8b8174; }
