<view class="personal-page profile-page"><personal-nav title="我的" /><view class="profile-content">
<view class="profile-intro"><view class="profile-emblem"><image src="/assets/personal/book.png" mode="aspectFit" /></view><view wx:if="{{user}}" class="profile-name">青囊书友</view><view class="profile-description">保存收藏与笔记，继续你的经典学习</view>
<button wx:if="{{!user}}" class="personal-primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">微信登录</button><button wx:else class="personal-sync" bindtap="sync">{{syncMessage}}</button><view wx:if="{{error}}" class="personal-error">{{error}}</view></view>
<view class="profile-menu">
<button class="profile-menu-row" data-page="favorites" bindtap="openPage"><image class="menu-icon" src="/assets/personal/star.png" /><text>我的收藏</text><image class="menu-chevron" src="/assets/personal/chevron.png" /></button>
<button class="profile-menu-row" data-page="notes" bindtap="openPage"><image class="menu-icon" src="/assets/personal/note.png" /><text>我的笔记</text><image class="menu-chevron" src="/assets/personal/chevron.png" /></button>
<button class="profile-menu-row" data-page="history" bindtap="openPage"><image class="menu-icon" src="/assets/personal/clock.png" /><text>历史记录</text><image class="menu-chevron" src="/assets/personal/chevron.png" /></button>
<button class="profile-menu-row" data-page="feedback" bindtap="openPage"><image class="menu-icon" src="/assets/personal/feedback.png" /><text>意见反馈</text><image class="menu-chevron" src="/assets/personal/chevron.png" /></button>
</view><view class="profile-footer"><button class="privacy-link" bindtap="openPrivacy">隐私保护指引</button><button wx:if="{{user}}" class="privacy-link" bindtap="logout">退出登录</button></view></view></view>
