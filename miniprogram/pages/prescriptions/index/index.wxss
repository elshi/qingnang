@import "../../../styles/catalog-list.wxss";
.prescription-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.prescription-tag { padding: 3rpx 9rpx; color: #9b6f2d; background: #f2e8d7; font-size: 21rpx; line-height: 1.4; border-radius: 3rpx; }
.prescription-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.prescription-page .catalog-search__clear { width: auto; margin: 0 0 0 12rpx; }
