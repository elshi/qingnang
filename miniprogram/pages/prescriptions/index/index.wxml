<view class="prescription-page catalog-page page-fade">
  <custom-nav title="经典经方" showBack="{{true}}"></custom-nav>
  <view class="catalog-search">
    <image src="/assets/cases/search.png" mode="aspectFit" aria-hidden="true"></image>
    <input class="catalog-search__input" value="{{keyword}}" placeholder="搜索方名、出处、主治、药材或简称" placeholder-class="catalog-search__placeholder" maxlength="100" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" />
    <button wx:if="{{keyword}}" class="catalog-search__clear" bindtap="clearSearch">清除</button>
  </view>
  <scroll-view class="prescription-scroll catalog-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}" lower-threshold="250" bindscrolltolower="loadMore">
    <view class="catalog-list">
      <view id="prescription-list-top" class="result-head"><text>{{isSearching ? '搜索结果' : '全部经方'}}</text><text wx:if="{{items.length || (!loading && !error)}}" class="result-count">{{total}} 方</text></view>
      <view wx:for="{{items}}" wx:key="id" class="catalog-card pressable" data-id="{{item.id}}" bindtap="openDetail" aria-role="button" aria-label="查看{{item.title}}">
        <view class="catalog-card__title">{{item.title}}</view>
        <view class="catalog-card__meta">{{item.source || '出处未注明'}}</view>
        <view wx:if="{{item.tags.length}}" class="prescription-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="prescription-tag">{{tag}}</text></view>
        <view wx:if="{{item.summary}}" class="catalog-card__content prescription-summary">{{item.summary}}</view>
      </view>
      <view wx:if="{{error}}" class="state-block"><view>{{error}}</view><button class="state-action" bindtap="retry">重新加载</button></view>
      <view wx:elif="{{loading}}" class="state-block">正在加载经方…</view>
      <view wx:elif="{{!items.length}}" class="state-block"><view>{{isSearching ? '未找到相关经方' : '暂无经方数据'}}</view><button wx:if="{{isSearching}}" class="state-action" bindtap="clearSearch">查看全部</button></view>
      <view wx:elif="{{!hasMore}}" class="state-block state-block--muted">已经到底了</view>
    </view>
    <view class="tabbar-spacer"></view>
  </scroll-view>
  <app-tab-bar></app-tab-bar>
</view>
