@import "../../../styles/personal.wxss";
@import "../../../styles/personal-catalog.wxss";
.note-editor-page .personal-body { padding:24rpx 30rpx calc(36rpx + env(safe-area-inset-bottom)); }
.source-row { display:flex; align-items:center; min-height:70rpx; padding:12rpx 18rpx; border:1rpx solid #e4d8c7; border-radius:7rpx; background:rgba(255,253,248,.78); color:#857664; font-size:23rpx; }
.source-row>text { flex-shrink:0; margin-right:18rpx; }
.source-row button { display:flex; align-items:center; min-width:0; margin:0 0 0 auto; color:#a27942; font-size:23rpx; text-align:right; }
.source-row image { flex-shrink:0; width:20rpx; height:20rpx; margin-left:8rpx; }
.source-tools { display:flex; justify-content:flex-end; }
.source-tools button { margin:0 0 0 20rpx; padding:10rpx 0; color:#9c855f; font-size:21rpx; }
.editor-title { width:100%; height:98rpx; color:#31291f; font-size:34rpx; font-weight:600; }
.editor-paper { padding:22rpx; border:1rpx solid #e1d6c6; border-radius:7rpx; background:rgba(255,253,248,.78); }
.editor-content { width:100%; min-height:400rpx; color:#514638; font-size:27rpx; line-height:1.75; }
.voice-button { display:flex; align-items:center; justify-content:flex-end; width:100%; min-height:56rpx; margin-top:14rpx; color:#a77936; font-size:23rpx; }
.voice-button image { width:27rpx; height:27rpx; margin-right:6rpx; }
.personal-page button.voice-button { width:100% !important; }
.voice-button--active { color:#a44735; }
.speech-preview { margin-top:16rpx; padding:14rpx; border-radius:7rpx; background:#f3ecdf; white-space:pre-wrap; }
.draft-status { margin-top:18rpx; }
.delete-note { margin-top:48rpx; color:#a06652; font-size:23rpx; padding:16rpx; }
.picker-mask { position:fixed; inset:0; z-index:200; display:flex; align-items:flex-end; background:rgba(47,36,25,.32); }
.source-picker { width:100%; background:#f8f3ea; border-radius:18rpx 18rpx 0 0; padding:26rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); }
.picker-title { display:flex; align-items:center; color:#31291f; font-size:27rpx; margin-bottom:16rpx; }
.picker-title button { margin-left:auto; color:#a77936; font-size:23rpx; padding:14rpx 0; }
.picker-list { height:55vh; }
