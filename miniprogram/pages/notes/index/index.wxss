@import "../../../styles/personal.wxss";
.note-row { padding:40rpx 0; border-bottom:1rpx solid #e9e1d7; }
.note-excerpt { margin-top:10rpx; color:#7e7467; font-size:34rpx; line-height:1.6; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
.note-footer { display:flex; justify-content:space-between; gap:20rpx; margin-top:18rpx; color:#948879; font-size:30rpx; line-height:1.5; }
.note-footer text:first-child { flex:1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.note-footer text:last-child { flex-shrink:0; }
.draft-entry { margin:16rpx 0 0; padding:16rpx; color:#a77936; background:#f3ecdf; font-size:30rpx; text-align:left; }
