@import "../../../styles/personal.wxss";
@import "../../../styles/personal-catalog.wxss";
.note-excerpt { margin-top:10rpx; color:#675e53; font-size:26rpx; line-height:1.55; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
.note-footer { display:flex; justify-content:space-between; gap:20rpx; margin-top:16rpx; color:#a27942; font-size:21rpx; line-height:1.5; }
.note-footer text:first-child { flex:1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.note-footer text:last-child { flex-shrink:0; }
.personal-list-page button.draft-entry { width:100% !important; margin:0 0 15rpx; padding:18rpx 22rpx; border:1rpx solid #e4d3b9; border-radius:7rpx; color:#a27942; background:#f3ecdf; font-size:24rpx; text-align:left; }

.personal-list-page { box-sizing:border-box; padding-bottom:calc(112rpx + env(safe-area-inset-bottom)); }
