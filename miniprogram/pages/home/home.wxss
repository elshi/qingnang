@import "../../styles/home-font.wxss";

page { background: #f8f3ea; }
.home-page {
  min-height: 100vh;
  padding: 0 30rpx calc(155rpx + env(safe-area-inset-bottom));
  color: #31291f;
  background: #f8f3ea;
}
.home-serif {
  font-family: "Qingnang Song", "Songti SC", "Noto Serif CJK SC", SimSun, serif;
  font-weight: 700;
}
.home-page button { font-weight: 400; }
.home-page .home-book, .home-page .home-result { width: 100%; }
.home-page .home-search__clear { width: auto; }
.home-brand { display: flex; align-items: center; gap: 18rpx; padding: 0 10rpx; }
.home-brand__mark { flex: 0 0 58rpx; width: 58rpx; height: 48rpx; }
.home-brand__title { font-size: 37rpx; line-height: 1.4; }
.home-search {
  display: flex; align-items: center; min-height: 68rpx;
  margin: 18rpx 0 0; padding: 0 24rpx;
  border: 1rpx solid #dfd3c2; border-radius: 38rpx; background: #fffcf7;
}
.home-search__icon { flex: 0 0 32rpx; width: 32rpx; height: 32rpx; margin-right: 17rpx; }
.home-search__input { flex: 1; min-width: 0; height: 68rpx; color: #40372d; font-size: 27rpx; }
.home-search__placeholder { color: #8a7d6e; }
.home-search__clear { flex-shrink: 0; margin: 0 0 0 8rpx; padding: 16rpx 0 16rpx 8rpx; color: #a27942; font-size: 23rpx; }
.home-shortcuts {
  display: flex; align-items: center; margin: 28rpx -30rpx 0; padding: 22rpx 20rpx;
  background: #f5eddf;
}
.home-shortcut { display: flex; flex: 1 1 0; align-items: center; justify-content: center; gap: 10rpx; min-height: 53rpx; font-size: 28rpx; line-height: 1.4; }
.home-shortcut + .home-shortcut { border-left: 1rpx solid #d9c7ad; }
.home-shortcut__icon { flex: 0 0 51rpx; width: 51rpx; height: 57rpx; }
.home-bookshelf { margin-top: 24rpx; }
.home-bookshelf__header, .home-results__header { display: flex; align-items: center; justify-content: space-between; min-height: 66rpx; }
.home-section-title { font-size: 38rpx; line-height: 1.4; }
.home-bookshelf__all { display: flex; align-items: center; gap: 8rpx; min-height: 76rpx; padding-left: 16rpx; color: #a27942; font-size: 25rpx; }
.home-chevron { flex: 0 0 16rpx; width: 16rpx; height: 26rpx; }
.home-bookshelf__books { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.home-book {
  display: flex; align-items: center; gap: 21rpx; width: 100%; min-width: 0;
  margin: 0; padding: 20rpx 11rpx 20rpx 0; border-radius: 0;
  border-bottom: 1rpx solid #ded0bd; color: #31291f; text-align: left;
}
.home-book:nth-child(even) { padding-right: 0; padding-left: 11rpx; }
.home-book__cover { flex: 0 0 104rpx; width: 104rpx; height: 152rpx; }
.home-book__copy { flex: 1; min-width: 0; }
.home-book__title, .home-book__author, .home-book__subject { display: block; }
.home-book__title { font-size: 30rpx; white-space: nowrap; line-height: 1.45; }
.home-book__author { margin-top: 9rpx; font-size: 25rpx; color: #857664; line-height: 1.45; }
.home-book__rule { width: 26rpx; height: 1rpx; background: #c9a670; margin: 18rpx 0; }
.home-book__subject { color: #857664; font-size: 25rpx; line-height: 1.45; white-space: nowrap; }
.home-cases { margin-top: 24rpx; }
.home-page .home-case { display: flex; align-items: center; width: 100%; margin: 0; padding: 17rpx 0; border-bottom: 1rpx solid #ded0bd; border-radius: 0; color: #31291f; text-align: left; }
.home-case__copy { flex: 1; min-width: 0; padding: 0 24rpx 0 0; }
.home-case__title, .home-case__source, .home-case__excerpt { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.home-case__title { font-size: 30rpx; line-height: 1.5; }
.home-case__source { color: #a27942; font-size: 23rpx; line-height: 1.5; margin-top: 4rpx; }
.home-case__excerpt { color: #857664; font-size: 25rpx; line-height: 1.5; margin-top: 5rpx; }
.home-link--pressed {
  opacity: 0.72;
}

.home-results {
  margin-top: 42rpx;
}

.home-results__header {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e1d6c6;
}

.home-results__count {
  color: #817466;
  font-size: 25rpx;
}

.home-result {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  width: 100%;
  margin: 0;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #e1d6c6;
  border-radius: 0;
  color: #31291f;
  text-align: left;
}

.home-row--pressed {
  background: #f1e8da;
}

.home-result__type {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  color: #a27942;
  background: #f1e8da;
  font-size: 22rpx;
}

.home-result__copy {
  flex: 1;
  min-width: 0;
}

.home-result__title,
.home-result__summary,
.home-results__empty-title {
  display: block;
}

.home-result__title,
.home-results__empty-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.home-result__summary {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #817466;
  font-size: 26rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.home-result .home-chevron {
  align-self: center;
}

.home-results__status {
  padding: 42rpx 14rpx;
  color: #817466;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.home-results__empty-title {
  margin-bottom: 8rpx;
  color: #31291f;
}

.home-results__action {
  min-height: 84rpx;
  padding: 0 16rpx;
  color: #a27942;
  font-size: 27rpx;
  line-height: 84rpx;
}

.home-cases__list .home-results__status {
  padding-right: 0;
  padding-left: 0;
  border-bottom: 1rpx solid #ded0bd;
  text-align: left;
}

.home-cases__list .home-results__action {
  width: auto;
  margin-left: 0;
  padding-left: 0;
}

@media (max-width: 360px) {
  .home-book { gap: 14rpx; }
  .home-book__title { font-size: 29rpx; }
  .home-shortcut { gap: 6rpx; }
}

.home-bookshelf__header button.home-bookshelf__all { width:auto !important; margin:0; padding:0 0 0 16rpx; background:transparent; font-weight:400; }
