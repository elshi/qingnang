@import "../../../styles/personal.wxss";
@import "../../../styles/personal-catalog.wxss";
.feedback-page .personal-body { padding-top:25rpx; padding-right:30rpx; padding-left:30rpx; }
.feedback-label { margin:25rpx 0 14rpx; color:#594b3b; font-size:27rpx; font-weight:600; }
.feedback-label text { font-size:22rpx; color:#8a8073; font-weight:400; }
.feedback-types { display:flex; gap:10rpx; margin-bottom:30rpx; }
.feedback-types button { flex:1; margin:0; padding:15rpx 3rpx; border:1rpx solid #e4dacd; border-radius:7rpx; font-size:23rpx; color:#675c4e; white-space:nowrap; background:rgba(255,253,248,.78); }
.feedback-types .feedback-type--active { color:#a77936; background:#f2e8d8; border-color:#bfa16e; }
.feedback-input { width:100%; height:80rpx; border:1rpx solid #e4dacd; border-radius:7rpx; padding:18rpx 20rpx; color:#514638; background:rgba(255,253,248,.78); font-size:25rpx; }
.feedback-textarea { height:190rpx; margin-bottom:26rpx; line-height:1.6; }
.feedback-images { display:flex; gap:14rpx; margin-bottom:28rpx; }
.feedback-image,.add-image { position:relative; width:120rpx; height:120rpx; flex-shrink:0; }
.feedback-image>image { width:120rpx; height:120rpx; border-radius:7rpx; }
.feedback-image button { position:absolute; top:-10rpx; right:-10rpx; width:40rpx; height:40rpx; background:#faf7f1; border:1rpx solid #e4dacd; border-radius:50%; display:flex; align-items:center; justify-content:center; }
.feedback-image button image { width:23rpx; height:23rpx; }
.add-image { display:flex; align-items:center; justify-content:center; margin:0; border:1rpx solid #e4dacd; border-radius:7rpx; background:rgba(255,253,248,.78); }
.add-image image { width:36rpx; height:36rpx; }
.personal-page button.add-image { width:120rpx !important; }
.personal-page .feedback-image button { width:40rpx !important; }
.feedback-thanks { margin-top:18rpx; text-align:center; }
.feedback-success { padding:100rpx 20rpx; text-align:center; }
.feedback-success>image { width:70rpx; height:70rpx; margin-bottom:24rpx; }

.personal-page button.add-image { margin:0 !important; }
